        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\n\nactor \&quot;Worker\&quot; as Worker\nactor \&quot;Enterprise Analyst\&quot; as Analyst\n\nrectangle \&quot;Cognitive Performance Monitoring System\&quot; {\n\n    (Register Account) as UC_Register\n    (Authenticate / Login) as UC_Login\n    (Connect Smartwatch) as UC_ConnectWatch\n    (Send Health Data Automatically) as UC_SendData\n    (Submit Manual Form) as UC_Form\n    (View Personal Health Report) as UC_ViewReport\n    (Receive Notifications) as UC_ReceiveNotif\n\n    (View Dashboard) as UC_ViewDashboard\n    (Filter / Analyze Historical Data) as UC_Analyze\n    (Receive Alerts) as UC_Alerts\n\n    (Ingest Data Stream) as UC_Ingest\n    (Preprocess Data) as UC_Preprocess\n    (Store Data) as UC_Store\n    (Train ML Model) as UC_Train\n    (Run Inference) as UC_Inference\n    (Trigger Notifications) as UC_TriggerNotif\n}\n\n&#39; --- Relationships ---\n\n&#39; Worker interactions\nWorker --&gt; UC_Register\nWorker --&gt; UC_Login\nWorker --&gt; UC_ConnectWatch\nWorker --&gt; UC_SendData\nWorker --&gt; UC_Form\nWorker --&gt; UC_ViewReport\nWorker &lt;-- UC_ReceiveNotif\n\n&#39; Analyst interactions\nAnalyst --&gt; UC_Login\nAnalyst --&gt; UC_ViewDashboard\nAnalyst --&gt; UC_Analyze\nAnalyst &lt;-- UC_Alerts\n\n&#39; System internals\nUC_SendData --&gt; UC_Ingest\nUC_Form --&gt; UC_Ingest\nUC_Ingest --&gt; UC_Preprocess\nUC_Preprocess --&gt; UC_Store\nUC_Preprocess --&gt; UC_Inference\nUC_Inference --&gt; UC_TriggerNotif\nUC_TriggerNotif --&gt; UC_ReceiveNotif\nUC_TriggerNotif --&gt; UC_Alerts\nUC_Train --&gt; UC_Store\n\n&#39; --- include/extend relationships ---\nUC_Register -down-&gt; UC_Login : &lt;&lt;include&gt;&gt;\nUC_ViewDashboard -down-&gt; UC_Analyze : &lt;&lt;include&gt;&gt;\nUC_SendData -right-&gt; UC_Preprocess : &lt;&lt;extend&gt;&gt;\nUC_Inference -right-&gt; UC_TriggerNotif : &lt;&lt;extend&gt;&gt;\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="aBDx4QGkji8yrYM3JLM5-9">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="756" width="1770" x="-3858" y="94" as="geometry" />
          </mxCell>
        </UserObject>
