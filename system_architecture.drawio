        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\n\nentity \&quot;Виробник\&quot; as Manufacturer {\n  *ID\n  Назва\n  Локація\n  Макс. потужність\n}\n\nentity \&quot;Модель дрона\&quot; as DroneModel {\n  *ID\n  Назва\n  Характеристики\n  Нормативний час\n}\n\nentity \&quot;Ресурс\&quot; as Resource {\n  *ID\n  Тип (машина/людина/матеріал)\n  Потужність\n  Доступність\n}\n\nentity \&quot;Замовлення\&quot; as Order {\n  *ID\n  Дата створення\n  Пріоритет\n  Статус\n  Військова частина\n}\n\nentity \&quot;Замовлена позиція\&quot; as OrderItem {\n  *ID\n  Кількість\n  Дата підтвердження\n}\n\nentity \&quot;План виробництва\&quot; as ProductionPlan {\n  *ID\n  Дата початку\n  Дата завершення\n  Статус\n}\n\nentity \&quot;Розподіл ресурсу\&quot; as ResourceAllocation {\n  *ID\n  Кількість\n  Початок\n  Кінець\n}\n\nentity \&quot;Передзамовлення\&quot; as Backorder {\n  *ID\n  Очікуваний термін\n  Статус підтвердження\n}\n\nentity \&quot;Накладна\&quot; as Invoice {\n  *ID\n  Дата\n  Кількість\n}\n\nentity \&quot;Акт приймання\&quot; as AcceptanceAct {\n  *ID\n  Дата підписання\n  Статус\n}\n\nentity \&quot;Оплата\&quot; as Payment {\n  *ID\n  Сума\n  Дата\n  Статус\n}\n\nentity \&quot;Календар\&quot; as Calendar {\n  *Дата\n  Робочий/вихідний\n}\n\n&#39; --- Зв’язки ---\nManufacturer ||--o{ ProductionPlan : формує\nProductionPlan ||--o{ ResourceAllocation : використовує\nResource ||--o{ ResourceAllocation : призначається\n\nOrder ||--o{ OrderItem : містить\nOrderItem }o--|| DroneModel : відноситься до\nOrderItem ||--o{ Backorder : може мати\n\nProductionPlan ||--o{ OrderItem : забезпечує\n\nOrder ||--o{ Invoice : породжує\nInvoice ||--|| AcceptanceAct : підтверджується\nAcceptanceAct ||--|| Payment : оплачується\n\nCalendar ||--o{ ProductionPlan : визначає робочі дні\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="MZDYIRu3sp4mbF4dbid_-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="853" width="596" x="-80" y="1064" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Use Case Diagram – Cognitive Performance Monitoring System\n\nactor \&quot;Worker\&quot; as Worker\nactor \&quot;Enterprise Analyst / Manager\&quot; as Analyst\nactor \&quot;System Services\\n(AWS Components, ML Engine)\&quot; as System\n\nrectangle \&quot;Cognitive Performance Monitoring System\&quot; {\n  \n  &#39; === Worker-related use cases ===\n  usecase \&quot;Submit Health Data\\n(from sensors / mobile)\&quot; as UC1\n  usecase \&quot;Receive Notifications\\n(alerts, reminders)\&quot; as UC2\n  usecase \&quot;View Personal Dashboard\\n(own trends, risk level)\&quot; as UC3\n  usecase \&quot;Acknowledge Alert / Feedback\&quot; as UC4\n  usecase \&quot;Track Recovery Plan\\n(optional follow-up)\&quot; as UC5\n  \n  &#39; === Analyst-related use cases ===\n  usecase \&quot;View Workforce Dashboard\\n(overall cognitive status)\&quot; as UC6\n  usecase \&quot;Receive Critical Alerts\\n(employee fatigue, anomalies)\&quot; as UC7\n  usecase \&quot;Access Historical Data\\n(aggregated analytics)\&quot; as UC8\n  usecase \&quot;Export Reports / Insights\&quot; as UC9\n  usecase \&quot;Adjust Alert Rules / Thresholds\&quot; as UC10\n  usecase \&quot;Manage Users / Permissions\&quot; as UC11\n\n  &#39; === System-internal use cases ===\n  usecase \&quot;Collect &amp; Preprocess Data\&quot; as UC12\n  usecase \&quot;Detect Cognitive Risks\\n(ML model inference)\&quot; as UC13\n  usecase \&quot;Generate Alert / Notification Event\&quot; as UC14\n  usecase \&quot;Store Data in Warehouse\\n(S3 / Redshift)\&quot; as UC15\n  usecase \&quot;Train ML Model\\n(on historical data)\&quot; as UC16\n}\n\n&#39; === Worker interactions ===\nWorker --&gt; UC1\nWorker &lt;-- UC2\nWorker --&gt; UC3\nWorker --&gt; UC4\nWorker --&gt; UC5\n\n&#39; === Analyst interactions ===\nAnalyst --&gt; UC6\nAnalyst &lt;-- UC7\nAnalyst --&gt; UC8\nAnalyst --&gt; UC9\nAnalyst --&gt; UC10\nAnalyst --&gt; UC11\n\n&#39; === System responsibilities ===\nSystem --&gt; UC12\nSystem --&gt; UC13\nSystem --&gt; UC14\nSystem --&gt; UC15\nSystem --&gt; UC16\n\n&#39; === Logical relationships ===\nUC1 --&gt; UC12 : &lt;&lt;include&gt;&gt;\nUC12 --&gt; UC13 : &lt;&lt;include&gt;&gt;\nUC13 --&gt; UC14 : &lt;&lt;include&gt;&gt;\nUC14 --&gt; UC2 : &lt;&lt;extend&gt;&gt;\nUC14 --&gt; UC7 : &lt;&lt;extend&gt;&gt;\nUC12 --&gt; UC15 : &lt;&lt;include&gt;&gt;\nUC8 --&gt; UC9 : &lt;&lt;extend&gt;&gt;\nUC16 --&gt; UC13 : &lt;&lt;include&gt;&gt;\nUC10 --&gt; UC14 : &lt;&lt;extend&gt;&gt;\nUC6 --&gt; UC8 : &lt;&lt;include&gt;&gt;\nUC3 --&gt; UC1 : &lt;&lt;include&gt;&gt;\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="aBDx4QGkji8yrYM3JLM5-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
