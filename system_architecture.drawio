        <mxCell id="KtHvz8X8nQ9n-cU2UUqv-73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#d5e8d4;strokeColor=#82b366;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="KtHvz8X8nQ9n-cU2UUqv-1" source="KtHvz8X8nQ9n-cU2UUqv-50" target="KtHvz8X8nQ9n-cU2UUqv-72" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1935" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; Functional design diagram for Employee Cognitive Monitoring (big-data)\n&#39; Keep it aligned with the user&#39;s provided architecture\n\nskinparam componentStyle rectangle\nskinparam shadowing false\nskinparam monochrome true\n\ntitle Functional Design Diagram — Employee Monitoring (Big Data)\n\n&#39; Left: edge / clients\npackage \&quot;Employees / Edge\&quot; {\n  component \&quot;Employee\\nMobile App\&quot; as MobileApp\n  note left of MobileApp\n    collects:\n    - user-entered vitals (JSON)\n    - synched smartwatch metrics\n  end note\n}\n\n&#39; Auth &amp; API border\npackage \&quot;Ingress / API\&quot; {\n  component \&quot;API Gateway\\n(HTTPS JSON)\&quot; as APIGW\n  component \&quot;Auth: Amazon Cognito\&quot; as Cognito\n  APIGW --&gt; Cognito : \&quot;authorize / validate tokens\&quot;\n  MobileApp --&gt; APIGW : \&quot;POST JSON (vitals, sensor sync)\&quot;\n}\n\n&#39; Optional lightweight preprocessor before stream\ncomponent \&quot;Optional Preprocess\\nLambda (light checks)\&quot; as OptPreproc\nAPIGW --&gt; OptPreproc : \&quot;invoke (optional)\&quot;\nOptPreproc --&gt; APIGW : \&quot;ok / error\&quot;\n\n&#39; Core ingestion\ncomponent \&quot;Preprocess Lambda\\n(schema checks, enrichment)\&quot; as Preproc\nAPIGW --&gt; Preproc : \&quot;invoke with validated JSON\&quot;\n\n&#39; Raw storage\ncomponent \&quot;S3 (raw snapshots)\\nstorage/raw/\&quot; as S3Raw\nPreproc --&gt; S3Raw : \&quot;write raw JSON snapshots (audit/archive)\&quot;\n\n&#39; Streaming layer\ncomponent \&quot;Stream processing\\nAmazon MSK (Kafka)\&quot; as MSK\nPreproc --&gt; MSK : \&quot;publish events (stream)\&quot;\n\n&#39; Structured streaming / processing\ncomponent \&quot;Structured Streaming\\nSpark (consumers)\&quot; as Spark\nMSK --&gt; Spark : \&quot;stream read\&quot;\n\n&#39; Stream outputs: snapshots + aggregates + features\ncomponent \&quot;S3 (stream snapshots)\\nstorage/stream-snapshots/\&quot; as S3StreamSnapshots\ncomponent \&quot;S3 (preprocessed / features)\\nstorage/preprocessed/, /features/\&quot; as S3Features\ncomponent \&quot;Aggregates (online)\\nDynamoDB\&quot; as DynamoDB\nSpark --&gt; S3StreamSnapshots : \&quot;periodic snapshots\&quot;\nSpark --&gt; DynamoDB : \&quot;write time-window aggregates (online)\&quot;\nSpark --&gt; S3Features : \&quot;write features / parquet (training inputs)\&quot;\n\n&#39; ML training and model management\ncomponent \&quot;Training (scheduled)\\nSageMaker training jobs\&quot; as SageTrain\ncomponent \&quot;SageMaker Model Registry\\n+ Endpoint (inference)\&quot; as SageEndpoint\nS3Features --&gt; SageTrain : \&quot;read features\&quot;\nSageTrain --&gt; SageEndpoint : \&quot;register model\&quot;\nSageEndpoint --&gt; SageEndpoint : \&quot;host endpoint (inference)\&quot;\n\n&#39; Historical / data lake\ncomponent \&quot;S3 (data lake)\\nstorage/raw/, /processed/, /models/\&quot; as S3DataLake\nS3Raw --&gt; S3DataLake : \&quot;archive / lifecycle\&quot;\nS3Features --&gt; S3DataLake : \&quot;store training artefacts\&quot;\nS3StreamSnapshots --&gt; S3DataLake : \&quot;archive snapshots\&quot;\n\n&#39; User / business DB\ncomponent \&quot;UserDB\\nAurora PostgreSQL\&quot; as Aurora\nnote right of Aurora\n  user profiles,\n  roles, enrollments,\n  long-lived business records\nend note\n\n&#39; Backend &amp; business logic\ncomponent \&quot;Backend\\nAWS Fargate / Lambda\&quot; as Backend\nBackend --&gt; Aurora : \&quot;read / write user &amp; status\&quot;\nBackend --&gt; SageEndpoint : \&quot;request inference (model)\&quot;\nBackend --&gt; DynamoDB : \&quot;read aggregates (fast online)\&quot;\nBackend --&gt; S3DataLake : \&quot;read analytics / historical\&quot;\n\n&#39; Notifications &amp; urgent alerts\ncomponent \&quot;Amazon Pinpoint\\n(urgent notifications)\&quot; as Pinpoint\nBackend --&gt; Pinpoint : \&quot;trigger urgent notifications\&quot;\n\n&#39; Frontend &amp; dashboards\ncomponent \&quot;Frontend\\nS3 + CloudFront (React SPA)\&quot; as Frontend\nFrontend --&gt; Backend : \&quot;REST requests / display aggregated insights\&quot;\nFrontend --&gt; Aurora : \&quot;read aggregated user info (via Backend)\&quot;\n\n&#39; Enterprise analytics &amp; export\ncomponent \&quot;Web App\\n(Enterprise Analytics)\&quot; as EnterpriseAnalytics\nS3DataLake --&gt; EnterpriseAnalytics : \&quot;analytics queries (ad hoc)\&quot;\nAurora --&gt; EnterpriseAnalytics : \&quot;business queries\&quot;\n\n&#39; Arrows for main flows summary (visual emphasis)\nAPIGW --&gt; Preproc : \&quot;validated JSON -&gt; preprocessing\&quot;\nPreproc --&gt; MSK : \&quot;event publish (stream)\&quot;\nSpark --&gt; S3Features : \&quot;feature extraction -&gt; features/\&quot;\nSageEndpoint --&gt; Backend : \&quot;prediction results\&quot;\nBackend --&gt; Frontend : \&quot;serve insights, statuses\&quot;\nBackend --&gt; Pinpoint : \&quot;send urgent alerts\&quot;\n\n&#39; Notes / annotations\nnote top of MSK\n  Real-time streaming layer:\n  - supports fault-tolerant buffering\n  - allows multiple consumers (analytics, aggregates, feature builders)\nend note\n\nnote bottom of DynamoDB\n  DynamoDB used for low-latency operational aggregates\n  (online feature / quick read for dashboard &amp; alerts)\nend note\n\nnote bottom of Aurora\n  Aurora PostgreSQL used as the canonical relational user DB:\n  - transactional user data\n  - ACID guarantees, complex joins, enterprise reporting\nend note\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_j7ypmjkOtA91NqbWsDl-0">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="KtHvz8X8nQ9n-cU2UUqv-1">
            <mxGeometry x="-200" y="710" width="2465" height="1535" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle DFD Level 0 – Context Diagram\n\nactor \&quot;User / Device / App\&quot; as User\nrectangle \&quot;User Data Analytics System\&quot; as System {\n}\n\nUser --&gt; System : Send user data\nSystem --&gt; User : Provide analytics / insights\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_j7ypmjkOtA91NqbWsDl-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="KtHvz8X8nQ9n-cU2UUqv-1">
            <mxGeometry x="-2770" y="-3170" width="504.61" height="369" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle DFD Level 1 – High-level Data Flow\n\nactor \&quot;User / Device / App\&quot; as User\n\nrectangle \&quot;1. Data Ingestion\\n(API Gateway / Kinesis)\&quot; as Ingest\nrectangle \&quot;2. Data Storage\\n(S3 Raw / Processed)\&quot; as Storage\nrectangle \&quot;3. Data Processing\\n(AWS Glue / Lambda / EMR)\&quot; as Process\nrectangle \&quot;4. ML &amp; Analytics\\n(SageMaker / Redshift)\&quot; as ML\nrectangle \&quot;5. Visualization\\n(QuickSight / Dashboard)\&quot; as Viz\n\nUser --&gt; Ingest : Send user data\nIngest --&gt; Storage : Store raw data\nStorage --&gt; Process : Provide data for cleaning\nProcess --&gt; Storage : Write processed data\nStorage --&gt; ML : Provide analytical datasets\nML --&gt; Viz : Provide model results\nViz --&gt; User : Show analytics / dashboards\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_j7ypmjkOtA91NqbWsDl-3">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="KtHvz8X8nQ9n-cU2UUqv-1">
            <mxGeometry x="-2040" y="-3550" width="1540.19" height="1223.5" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!define RECTANGLE class\nskinparam class {\n  BackgroundColor White\n  ArrowColor Black\n  BorderColor Black\n}\n\ntitle DFD Level 2+ – Detailed AWS Data Flow\n\nRECTANGLE \&quot;External Entity:\\nUser / Device / App\&quot; as User\nRECTANGLE \&quot;API Gateway / Load Balancer\\n(Data Ingestion Layer)\&quot; as Gateway\nRECTANGLE \&quot;Stream Processor:\\nAWS Kinesis / Kafka (MSK)\&quot; as Stream\nRECTANGLE \&quot;Lambda / Glue ETL Jobs\\n(Data Transformation)\&quot; as ETL\nRECTANGLE \&quot;Raw Data Store:\\nAmazon S3 (Raw Zone)\&quot; as S3Raw\nRECTANGLE \&quot;Processed Data Store:\\nAmazon S3 / Redshift (Curated Zone)\&quot; as S3Processed\nRECTANGLE \&quot;Feature Store:\\nPreprocessed ML Data\&quot; as FeatureStore\nRECTANGLE \&quot;ML Engine:\\nAWS SageMaker (Training &amp; Inference)\&quot; as ML\nRECTANGLE \&quot;Visualization Layer:\\nAmazon QuickSight / Dashboard\&quot; as Viz\nRECTANGLE \&quot;Metadata &amp; Control DB:\\nRDS / DynamoDB\&quot; as MetaDB\nRECTANGLE \&quot;Cache / Low-latency Layer:\\nElastiCache (Redis)\&quot; as Cache\n\n&#39; --- Connections ---\nUser --&gt; Gateway : 1. Send user interaction data\nGateway --&gt; Stream : 2. Forward events / API payloads\nStream --&gt; S3Raw : 3. Store raw event logs\nStream --&gt; ETL : 4. Trigger streaming jobs\n\nETL --&gt; S3Processed : 5. Write cleaned &amp; aggregated data\nETL --&gt; FeatureStore : 6. Generate ML-ready datasets\nETL --&gt; MetaDB : 7. Update metadata, logs\n\nS3Processed --&gt; ML : 8. Load training data\nFeatureStore --&gt; ML : 9. Provide feature vectors\nML --&gt; S3Processed : 10. Output predictions / model results\nML --&gt; Viz : 11. Send aggregated insights\nML --&gt; Cache : 12. Store fast-access predictions\n\nViz --&gt; MetaDB : 13. Fetch metadata / configs\nViz --&gt; Cache : 14. Retrieve cached ML results\nViz --&gt; User : 15. Display analytics dashboards\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_j7ypmjkOtA91NqbWsDl-4">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="KtHvz8X8nQ9n-cU2UUqv-1">
            <mxGeometry x="-170" y="-3410" width="1117" height="1022" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle DFD Level 0 – Context Diagram\n\nactor \&quot;Worker App\\n(sensor / mobile)\&quot; as Worker\nactor \&quot;Enterprise Analytics\\nWeb Dashboard\&quot; as Analyst\n\nrectangle \&quot;Occupational Health\\nMonitoring System\&quot; as System\n\nWorker --&gt; System : Send physiological data (JSON)\nSystem --&gt; Analyst : Provide insights, alerts, dashboards\nSystem --&gt; Worker : Send notifications / feedback\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_j7ypmjkOtA91NqbWsDl-5">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="KtHvz8X8nQ9n-cU2UUqv-1">
            <mxGeometry x="-1440" y="-118.00999999999999" width="468" height="468" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle DFD Level 1 – Main Data Flow\n\nactor \&quot;Worker App\&quot; as Worker\nactor \&quot;Enterprise Analytics\&quot; as Analyst\n\nrectangle \&quot;1. Data Ingestion\\n(API Gateway / IoT Core / Kinesis)\&quot; as Ingest\nrectangle \&quot;2. Data Lake\\n(S3 Raw / Processed Zones)\&quot; as DataLake\nrectangle \&quot;3. Data Processing\\n(AWS Glue / Lambda / EMR)\&quot; as Process\nrectangle \&quot;4. ML Analysis &amp; Alerting\\n(SageMaker / SNS)\&quot; as ML\nrectangle \&quot;5. Visualization &amp; Access\\n(QuickSight / WebApp)\&quot; as Viz\n\nWorker --&gt; Ingest : 1 Send JSON data\nIngest --&gt; DataLake : 2 Store raw data\nDataLake --&gt; Process : 3 Provide data for ETL\nProcess --&gt; DataLake : 4 Store cleaned / aggregated data\nProcess --&gt; ML : 5 Send prepared datasets\nML --&gt; DataLake : 6 Store predictions\nML --&gt; Viz : 7 Send alerts / insights\nViz --&gt; Analyst : 8 Display dashboards\nML --&gt; Worker : 9 Send notifications (via SNS)\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="_j7ypmjkOtA91NqbWsDl-6">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="KtHvz8X8nQ9n-cU2UUqv-1">
            <mxGeometry x="-2400" y="-368" width="845" height="898" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle DFD Level 2+ – Detailed AWS Data Flow\n\nactor \&quot;Worker App\\n(sensor data)\&quot; as Worker\nactor \&quot;Enterprise Analyst\\n(Web Dashboard)\&quot; as Analyst\n\nrectangle \&quot;API Gateway / IoT Core\&quot; as Gateway\nrectangle \&quot;Stream Processor\\n(Kinesis / Kafka MSK)\&quot; as Stream\nrectangle \&quot;Raw Zone\\n(S3 – Raw Data)\&quot; as S3Raw\nrectangle \&quot;ETL &amp; Data Processing\\n(Lambda / Glue / EMR)\&quot; as ETL\nrectangle \&quot;Processed Zone\\n(S3 – Curated Data)\&quot; as S3Processed\nrectangle \&quot;Metadata Store\\n(RDS / DynamoDB)\&quot; as Meta\nrectangle \&quot;Feature Store\\n(Preprocessed ML Data)\&quot; as Features\nrectangle \&quot;ML Model Training &amp; Inference\\n(SageMaker)\&quot; as ML\nrectangle \&quot;Notification Service\\n(SNS / EventBridge)\&quot; as Notify\nrectangle \&quot;Analytics &amp; Visualization\\n(Redshift / QuickSight / WebApp)\&quot; as Viz\nrectangle \&quot;Cache Layer\\n(ElastiCache Redis)\&quot; as Cache\n\n&#39; --- Flows ---\nWorker --&gt; Gateway : 1. Send JSON sensor data\nGateway --&gt; Stream : 2. Stream events\nStream --&gt; S3Raw : 3. Store raw data\nStream --&gt; ETL : 4. Trigger processing jobs\nETL --&gt; S3Processed : 5. Save cleaned data\nETL --&gt; Features : 6. Create ML-ready features\nETL --&gt; Meta : 7. Update metadata\nFeatures --&gt; ML : 8. Train / infer model\nML --&gt; S3Processed : 9. Store results / predictions\nML --&gt; Notify : 10. Trigger alerts / notifications\nNotify --&gt; Worker : 11. Send alerts to app\nNotify --&gt; Analyst : 12. Send enterprise alerts\nML --&gt; Cache : 13. Save fast-access data\nS3Processed --&gt; Viz : 14. Provide analytics data\nCache --&gt; Viz : 15. Provide real-time insights\nViz --&gt; Analyst : 16. Dashboard view\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_j7ypmjkOtA91NqbWsDl-7">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="KtHvz8X8nQ9n-cU2UUqv-1">
            <mxGeometry x="-3890" y="-440" width="1000" height="1163" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Big Data Architecture Diagram – Cognitive Performance Monitoring System\n\nskinparam rectangle {\n  BackgroundColor&lt;&lt;layer&gt;&gt; #F5F5F5\n  BorderColor #AAAAAA\n  RoundCorner 15\n}\n\n&#39; === ACTORS ===\nactor \&quot;Worker App\\n(Sensors, Mobile)\&quot; as Worker\nactor \&quot;Enterprise Analyst\\n(Web Dashboard)\&quot; as Analyst\n\n&#39; === LAYERS ===\n\nrectangle \&quot;Data Ingestion Layer\&quot; &lt;&lt;layer&gt;&gt; {\n  rectangle \&quot;API Gateway\\nIoT Core\&quot; as APIG\n  rectangle \&quot;Kinesis Data Stream\\n(MSK Kafka optional)\&quot; as Stream\n}\n\nrectangle \&quot;Storage Layer\&quot; &lt;&lt;layer&gt;&gt; {\n  rectangle \&quot;Amazon S3\\nRaw Zone\&quot; as S3Raw\n  rectangle \&quot;Amazon S3\\nProcessed Zone\&quot; as S3Processed\n  rectangle \&quot;Amazon RDS / DynamoDB\\nMetadata Store\&quot; as Meta\n  rectangle \&quot;Feature Store\\n(SageMaker / Glue Data Catalog)\&quot; as Features\n}\n\nrectangle \&quot;Processing Layer\&quot; &lt;&lt;layer&gt;&gt; {\n  rectangle \&quot;AWS Lambda\\n(Real-time ETL)\&quot; as Lambda\n  rectangle \&quot;AWS Glue / EMR\\n(Batch ETL / Enrichment)\&quot; as Glue\n}\n\nrectangle \&quot;Machine Learning Layer\&quot; &lt;&lt;layer&gt;&gt; {\n  rectangle \&quot;SageMaker Training\\n(Model Development)\&quot; as Train\n  rectangle \&quot;SageMaker Endpoint\\n(Model Inference)\&quot; as Infer\n  rectangle \&quot;SNS / EventBridge\\n(Alerting)\&quot; as Notify\n}\n\nrectangle \&quot;Analytics &amp; Visualization Layer\&quot; &lt;&lt;layer&gt;&gt; {\n  rectangle \&quot;Amazon Redshift\\nData Warehouse\&quot; as Redshift\n  rectangle \&quot;Amazon QuickSight\\nDashboards\&quot; as QuickSight\n  rectangle \&quot;ElastiCache (Redis)\\nReal-time cache\&quot; as Cache\n}\n\nrectangle \&quot;Access Layer\&quot; &lt;&lt;layer&gt;&gt; {\n  rectangle \&quot;Web Portal\\n(Enterprise Dashboard)\&quot; as WebPortal\n  rectangle \&quot;Mobile App\\n(Notifications &amp; Insights)\&quot; as MobileApp\n}\n\n&#39; === CONNECTIONS ===\n\nWorker --&gt; APIG : Sensor data (JSON)\nAPIG --&gt; Stream : Data stream ingestion\nStream --&gt; S3Raw : Raw data storage\nStream --&gt; Lambda : Trigger real-time ETL\nLambda --&gt; Glue : Schedule batch ETL\nLambda --&gt; S3Processed : Store preprocessed data\nGlue --&gt; S3Processed : Aggregated / Enriched data\nGlue --&gt; Features : Store ML features\nFeatures --&gt; Train : Train ML model\nTrain --&gt; Infer : Deploy inference endpoint\nS3Processed --&gt; Infer : Input for inference\nInfer --&gt; Notify : Send alerts\nNotify --&gt; MobileApp : Push notifications\nInfer --&gt; Redshift : Store predictions\nRedshift --&gt; QuickSight : Visualization data\nQuickSight --&gt; WebPortal : Display dashboards\nRedshift --&gt; Cache : Fast queries\nCache --&gt; WebPortal : Real-time dashboard refresh\nMeta --&gt; Glue : Metadata access\nAnalyst --&gt; WebPortal : View reports\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_j7ypmjkOtA91NqbWsDl-9">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="KtHvz8X8nQ9n-cU2UUqv-1">
            <mxGeometry x="-2150" y="1530" width="948" height="1655" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Use Case Diagram – Worker Interaction\n\nactor \&quot;Worker\&quot; as Worker\n\nrectangle \&quot;Cognitive Performance Monitoring System\&quot; {\n  usecase \&quot;Submit Health Data\\n(via mobile or wearable)\&quot; as UC1\n  usecase \&quot;Receive Notifications\\n(fatigue, stress, risk alerts)\&quot; as UC2\n  usecase \&quot;View Personal Dashboard\\n(health trends, scores)\&quot; as UC3\n  usecase \&quot;Acknowledge or Respond to Alert\&quot; as UC4\n}\n\nWorker --&gt; UC1\nWorker &lt;-- UC2\nWorker --&gt; UC3\nWorker --&gt; UC4\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_j7ypmjkOtA91NqbWsDl-10">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="KtHvz8X8nQ9n-cU2UUqv-1">
            <mxGeometry x="-2220" y="3670" width="1147" height="258" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Use Case Diagram – Enterprise Analyst / Manager Interaction\n\nactor \&quot;Enterprise Analyst / Manager\&quot; as Analyst\n\nrectangle \&quot;Cognitive Performance Monitoring System\&quot; {\n  usecase \&quot;View Workforce Dashboard\\n(risk indicators, status summary)\&quot; as UC1\n  usecase \&quot;Receive Critical Alerts\\n(employee overload, anomaly detected)\&quot; as UC2\n  usecase \&quot;Access Historical Data\\n(performance trends, reports)\&quot; as UC3\n  usecase \&quot;Export Analytics / Reports\&quot; as UC4\n  usecase \&quot;Adjust Alert Rules / Thresholds\&quot; as UC5\n}\n\nAnalyst --&gt; UC1\nAnalyst &lt;-- UC2\nAnalyst --&gt; UC3\nAnalyst --&gt; UC4\nAnalyst --&gt; UC5\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_j7ypmjkOtA91NqbWsDl-11">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="KtHvz8X8nQ9n-cU2UUqv-1">
            <mxGeometry x="-2350" y="3360" width="1521" height="266" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Use Case Diagram – Combined View\n\nactor \&quot;Worker\&quot; as Worker\nactor \&quot;Enterprise Analyst / Manager\&quot; as Analyst\n\nrectangle \&quot;Cognitive Performance Monitoring System\&quot; {\n  usecase \&quot;Submit Health Data\&quot; as U1\n  usecase \&quot;Receive Notifications\&quot; as U2\n  usecase \&quot;View Personal Dashboard\&quot; as U3\n  usecase \&quot;View Workforce Dashboard\&quot; as U4\n  usecase \&quot;Receive Critical Alerts\&quot; as U5\n  usecase \&quot;Access Historical Reports\&quot; as U6\n  usecase \&quot;Adjust Alert Thresholds\&quot; as U7\n}\n\nWorker --&gt; U1\nWorker &lt;-- U2\nWorker --&gt; U3\n\nAnalyst --&gt; U4\nAnalyst &lt;-- U5\nAnalyst --&gt; U6\nAnalyst --&gt; U7\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_j7ypmjkOtA91NqbWsDl-12">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="KtHvz8X8nQ9n-cU2UUqv-1">
            <mxGeometry x="-2560" y="4190" width="1593" height="244" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Use Case Diagram – Cognitive Performance Monitoring System\n\nactor \&quot;Worker\&quot; as Worker\nactor \&quot;Enterprise Analyst / Manager\&quot; as Analyst\nactor \&quot;System Services\\n(AWS Components, ML Engine)\&quot; as System\n\nrectangle \&quot;Cognitive Performance Monitoring System\&quot; {\n  \n  &#39; === Worker-related use cases ===\n  usecase \&quot;Submit Health Data\\n(from sensors / mobile)\&quot; as UC1\n  usecase \&quot;Receive Notifications\\n(alerts, reminders)\&quot; as UC2\n  usecase \&quot;View Personal Dashboard\\n(own trends, risk level)\&quot; as UC3\n  usecase \&quot;Acknowledge Alert / Feedback\&quot; as UC4\n  usecase \&quot;Track Recovery Plan\\n(optional follow-up)\&quot; as UC5\n  \n  &#39; === Analyst-related use cases ===\n  usecase \&quot;View Workforce Dashboard\\n(overall cognitive status)\&quot; as UC6\n  usecase \&quot;Receive Critical Alerts\\n(employee fatigue, anomalies)\&quot; as UC7\n  usecase \&quot;Access Historical Data\\n(aggregated analytics)\&quot; as UC8\n  usecase \&quot;Export Reports / Insights\&quot; as UC9\n  usecase \&quot;Adjust Alert Rules / Thresholds\&quot; as UC10\n  usecase \&quot;Manage Users / Permissions\&quot; as UC11\n\n  &#39; === System-internal use cases ===\n  usecase \&quot;Collect &amp; Preprocess Data\&quot; as UC12\n  usecase \&quot;Detect Cognitive Risks\\n(ML model inference)\&quot; as UC13\n  usecase \&quot;Generate Alert / Notification Event\&quot; as UC14\n  usecase \&quot;Store Data in Warehouse\\n(S3 / Redshift)\&quot; as UC15\n  usecase \&quot;Train ML Model\\n(on historical data)\&quot; as UC16\n}\n\n&#39; === Worker interactions ===\nWorker --&gt; UC1\nWorker &lt;-- UC2\nWorker --&gt; UC3\nWorker --&gt; UC4\nWorker --&gt; UC5\n\n&#39; === Analyst interactions ===\nAnalyst --&gt; UC6\nAnalyst &lt;-- UC7\nAnalyst --&gt; UC8\nAnalyst --&gt; UC9\nAnalyst --&gt; UC10\nAnalyst --&gt; UC11\n\n&#39; === System responsibilities ===\nSystem --&gt; UC12\nSystem --&gt; UC13\nSystem --&gt; UC14\nSystem --&gt; UC15\nSystem --&gt; UC16\n\n&#39; === Logical relationships ===\nUC1 --&gt; UC12 : &lt;&lt;include&gt;&gt;\nUC12 --&gt; UC13 : &lt;&lt;include&gt;&gt;\nUC13 --&gt; UC14 : &lt;&lt;include&gt;&gt;\nUC14 --&gt; UC2 : &lt;&lt;extend&gt;&gt;\nUC14 --&gt; UC7 : &lt;&lt;extend&gt;&gt;\nUC12 --&gt; UC15 : &lt;&lt;include&gt;&gt;\nUC8 --&gt; UC9 : &lt;&lt;extend&gt;&gt;\nUC16 --&gt; UC13 : &lt;&lt;include&gt;&gt;\nUC10 --&gt; UC14 : &lt;&lt;extend&gt;&gt;\nUC6 --&gt; UC8 : &lt;&lt;include&gt;&gt;\nUC3 --&gt; UC1 : &lt;&lt;include&gt;&gt;\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_j7ypmjkOtA91NqbWsDl-13">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="KtHvz8X8nQ9n-cU2UUqv-1">
            <mxGeometry x="-3000" y="4790" width="1740" height="959" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Database Model Diagram – Cognitive Performance Monitoring System\n\nentity \&quot;User\&quot; as U {\n  * user_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  name : varchar\n  email : varchar\n  role : enum(\&quot;worker\&quot;, \&quot;analyst\&quot;, \&quot;admin\&quot;)\n  organization_id : UUID &lt;&lt;FK&gt;&gt;\n  created_at : datetime\n}\n\nentity \&quot;Organization\&quot; as O {\n  * organization_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  name : varchar\n  industry : varchar\n  created_at : datetime\n}\n\nentity \&quot;SensorData\&quot; as SD {\n  * record_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  user_id : UUID &lt;&lt;FK&gt;&gt;\n  timestamp : datetime\n  heart_rate : float\n  temperature : float\n  sleep_duration : float\n  reaction_time : float\n  cognitive_score : float\n  raw_payload : json\n}\n\nentity \&quot;ProcessedMetrics\&quot; as PM {\n  * metric_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  user_id : UUID &lt;&lt;FK&gt;&gt;\n  timestamp : datetime\n  stress_level : float\n  fatigue_index : float\n  focus_score : float\n  anomaly_flag : boolean\n}\n\nentity \&quot;ModelPrediction\&quot; as MP {\n  * prediction_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  user_id : UUID &lt;&lt;FK&gt;&gt;\n  metric_id : UUID &lt;&lt;FK&gt;&gt;\n  risk_level : enum(\&quot;low\&quot;, \&quot;medium\&quot;, \&quot;high\&quot;)\n  confidence : float\n  model_version : varchar\n  created_at : datetime\n}\n\nentity \&quot;Alert\&quot; as A {\n  * alert_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  user_id : UUID &lt;&lt;FK&gt;&gt;\n  prediction_id : UUID &lt;&lt;FK&gt;&gt;\n  alert_type : enum(\&quot;cognitive_risk\&quot;, \&quot;fatigue\&quot;, \&quot;stress\&quot;)\n  status : enum(\&quot;new\&quot;, \&quot;acknowledged\&quot;, \&quot;resolved\&quot;)\n  message : text\n  created_at : datetime\n  resolved_at : datetime\n}\n\nentity \&quot;Notification\&quot; as N {\n  * notification_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  alert_id : UUID &lt;&lt;FK&gt;&gt;\n  recipient_id : UUID &lt;&lt;FK&gt;&gt;\n  channel : enum(\&quot;mobile\&quot;, \&quot;email\&quot;, \&quot;dashboard\&quot;)\n  sent_at : datetime\n  delivery_status : enum(\&quot;sent\&quot;, \&quot;failed\&quot;, \&quot;read\&quot;)\n}\n\nentity \&quot;ModelTraining\&quot; as MT {\n  * training_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  model_version : varchar\n  training_start : datetime\n  training_end : datetime\n  dataset_size : int\n  accuracy : float\n  f1_score : float\n  notes : text\n}\n\nentity \&quot;AlertRule\&quot; as AR {\n  * rule_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  organization_id : UUID &lt;&lt;FK&gt;&gt;\n  rule_name : varchar\n  metric_type : varchar\n  threshold_value : float\n  condition : enum(\&quot;&gt;\&quot;, \&quot;&lt;\&quot;, \&quot;&gt;=\&quot;, \&quot;&lt;=\&quot;)\n  active : boolean\n  updated_at : datetime\n}\n\n&#39; === Relationships ===\nO ||--o{ U : \&quot;has users\&quot;\nU ||--o{ SD : \&quot;records\&quot;\nU ||--o{ PM : \&quot;has metrics\&quot;\nPM ||--|| MP : \&quot;input to prediction\&quot;\nMP ||--o{ A : \&quot;triggers alerts\&quot;\nA ||--o{ N : \&quot;notifies\&quot;\nO ||--o{ AR : \&quot;defines rules\&quot;\nMT ||--o{ MP : \&quot;produces model\&quot;\nU ||--o{ A : \&quot;receives alerts\&quot;\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_j7ypmjkOtA91NqbWsDl-14">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="KtHvz8X8nQ9n-cU2UUqv-1">
            <mxGeometry x="-2520" y="5970" width="993" height="1342" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
